MONGODB_URI=mongodb://127.0.0.1:27017/hoa-binh-mini-app
# Optional: use when mongodb+srv DNS lookups fail with querySrv ECONNREFUSED
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# IMPORTANT: never point .env.local (dev) at the same database name used in
# production, even on the same Atlas cluster - use a distinct name (e.g. a
# "-dev" suffix) so a local `npm run seed` (which wipes all demo data) can
# never reach real data. scripts/seed.ts also refuses to run against database
# names listed in PROTECTED_DB_NAMES (src/lib/config.ts) as a second layer of
# defense, but the naming convention below is the actual fix - the guard is
# a backstop, not a substitute for it.
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=180d

# Khoa ma hoa AES-256-GCM cho du lieu nhay cam (sdt, cccd cua Citizen) - PHAI
# la chuoi base64 ma hoa dung 32 byte, tao bang: openssl rand -base64 32
# Khong duoc doi khoa nay sau khi da co du lieu ma hoa trong DB, neu khong
# toan bo du lieu cu se khong the giai ma duoc nua.
ENCRYPTION_KEY=

# ZALO_ENV=production yeu cau ZALO_APP_ID/ZALO_APP_SECRET that de xac thuc accessToken
# qua Zalo Graph API. Mac dinh sandbox de dev/test khong can Zalo App that.
ZALO_ENV=sandbox
ZALO_APP_ID=
ZALO_APP_SECRET=

# Khoa bi mat cua Official Account gan voi Mini App (lay tu trang quan tri OA,
# KHAC voi ZALO_APP_SECRET o tren) - dung de xac thuc header X-ZEvent-Signature
# cua webhook Zalo goi den /api/webhooks/zalo. Bat buoc phai co khi
# NODE_ENV=production (xem lib/config.ts validateZaloWebhookConfig), neu khong
# app se tu choi khoi dong.
ZALO_OA_SECRET_KEY=

# Domain duoc phep goi API. Chi ap dung khi NODE_ENV=production (dev/local
# luon cho phep tat ca origin de tien test). De trong se mac dinh hiscustom.io.vn.
CORS_ORIGIN=https://hiscustom.io.vn

# Origin cong khai (scheme + host, KHONG co dau "/" cuoi) dung de ghep vao url
# tuong doi cua file tai len ("/uploads/...") khi tra ve cho client (xem
# lib/localUpload.ts getPublicOrigin). Server chay sau nginx reverse proxy nen
# khong the tu suy ra domain cong khai tu chinh request (xem cung comment) -
# BAT BUOC dat gia tri nay o moi moi truong deploy thuc su, neu khong url file
# se bi ghi sai thanh "http://localhost:3000/...". Vi du: dev dat
# "https://api.dev.quanlytodanpho.com", prod dat "https://hiscustom.io.vn".
# De trong khi chay local (npm run dev) - luc do fallback ve origin cua chinh
# request la dung.
PUBLIC_API_ORIGIN=

# true = bat /api/auth/otp/request va /api/auth/otp/verify (dang nhap/dang ky
# bang OTP). false (mac dinh) = hai route nay tra ve 404, chi con dang nhap
# bang mat khau (khong doi hanh vi hien tai cua /api/auth/login|register).
# Chua co nha cung cap SMS/Zalo ZNS that duoc tich hop - OtpDeliveryAdapter
# (services/otpService.ts) hien chi la stub, log ma ra console o non-production.
AUTH_OTP_ENABLED=false
# Dat true CHI SAU KHI da tich hop that voi nha cung cap OTP - bat buoc phai co
# khi AUTH_OTP_ENABLED=true va NODE_ENV=production, neu khong app se tu choi
# khoi dong (xem lib/config.ts validateAuthConfig, goi tu instrumentation.ts).
OTP_PROVIDER_CONFIGURED=

# Khoa Goong Maps Platform DUNG RIENG O SERVER (Place Autocomplete + Place
# Detail) - proxy qua /api/houses/geo/{autocomplete,place-details} (xem
# lib/integrations/goong.ts). Dang ky mien phi tai https://account.goong.io.
GOONG_API_KEY=

# Khoa Google Maps Platform DUNG RIENG O SERVER (CHI Maps Static API) - proxy
# qua /api/houses/geo/static-map (xem lib/integrations/googleMaps.ts). Goong
# khong co endpoint anh tinh theo center+zoom nen rieng buoc nay van dung
# Google. Han che theo IP server tren Google Cloud Console, KHONG bao gio dua
# vao client. KHAC voi VITE_GOOGLE_MAPS_BROWSER_API_KEY cua admin-web-app
# (khoa do han che theo HTTP referrer, chi bat Maps JavaScript API, dung de ve
# ban do tong hop cho nhan vien).
GOOGLE_MAPS_SERVER_API_KEY=
